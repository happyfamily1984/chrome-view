<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="6dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="뒤로"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="크롬뷰 설정"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:lineSpacingExtra="4dp"
                android:text="인증하고 돌아와도\n페이지가 그대로 남게 합니다"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnChrome"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_btn"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_globe" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Chrome 열기"
                android:textColor="@color/on_accent"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp">

            <View
                android:layout_width="5dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_accent_bar" />

            <TextView
                style="@style/Section"
                android:text="유지 설정" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowDefault"
            style="@style/Row">

            <ImageView
                style="@style/RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_monitor" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/RowTitle"
                    android:text="기본 브라우저를 크롬뷰로" />
                <TextView
                    style="@style/RowSub"
                    android:text="다른 앱의 링크도 크롬뷰가 받아서 엽니다" />
            </LinearLayout>

            <TextView
                android:id="@+id/defaultState"
                style="@style/RowState" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSelf"
            style="@style/Row">

            <ImageView
                style="@style/RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_battery" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/RowTitle"
                    android:text="크롬뷰 배터리 제한 없음" />
            </LinearLayout>

            <TextView
                android:id="@+id/selfState"
                style="@style/RowState" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowChrome"
            style="@style/Row">

            <ImageView
                style="@style/RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_battery" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/RowTitle"
                    android:text="Chrome 배터리 제한 없음" />
                <TextView
                    style="@style/RowSub"
                    android:text="눌러서 배터리 → '제한 없음' 선택" />
            </LinearLayout>

            <TextView
                style="@style/RowState"
                android:text="설정 열기" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    style="@style/RowIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clock" />

                <Switch
                    android:id="@+id/autoStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="폰을 켜면 자동으로 유지 시작"
                    android:textColor="@color/text"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    style="@style/RowIcon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield" />

                <Switch
                    android:id="@+id/usePinned"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="크롬뷰 고정 창으로 열기 (권장)"
                    android:textColor="@color/text"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="14dp"
            android:lineSpacingExtra="4dp"
            android:text="켜면 페이지를 크롬뷰 안에서 열어 직접 붙잡습니다. 인증이 풀리지 않는 방식입니다.\n끄면 아이콘과 링크가 Chrome 앱으로 넘어갑니다. Chrome 안의 탭은 Chrome이 스스로 내릴 수 있어 유지가 보장되지 않습니다."
            android:textColor="@color/sub"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/rowDiag"
            style="@style/Row">

            <ImageView
                style="@style/RowIcon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/RowTitle"
                    android:text="진단 기록" />
                <TextView
                    style="@style/RowSub"
                    android:text="인증이 풀렸을 때 무슨 일이 있었는지 확인" />
            </LinearLayout>

            <TextView
                style="@style/RowState"
                android:text="보기" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp">

            <View
                android:layout_width="5dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_accent_bar" />

            <TextView
                style="@style/Section"
                android:text="알아 두기" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="14dp"
            android:lineSpacingExtra="4dp"
            android:text="1. 고정 창은 Chrome과 로그인 정보를 따로 씁니다. 사이트마다 처음 한 번은 다시 로그인해 주세요. 이후에는 유지됩니다.\n2. 최근 앱 화면에서 크롬뷰를 밀어서 닫지 마세요. 크롬뷰 아이콘을 누르고 '이 앱 잠금'을 해 두면 더 안전합니다.\n3. Chrome에서 보던 페이지는 Chrome 메뉴의 공유 → 크롬뷰로 보내면 고정 창에서 열립니다."
            android:textColor="@color/text"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
